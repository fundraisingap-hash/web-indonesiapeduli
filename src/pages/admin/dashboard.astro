const pct = (r, t) => t ? Math.min(100, Math.round(r/t*100)) : 0;

// SEC-02/03 fix: sanitize all user-supplied data before innerHTML
const escHtml = (s) => String(s ?? '')
  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
  .replace(/"/g,'&quot;').replace(/'/g,'&#x27;');

