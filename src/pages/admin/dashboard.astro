// ── Helpers ─────────────────────────────────────────
const fmtRp = n => n >= 1e9
  ? `Rp ${(n/1e9).toFixed(1)} M`
  : n >= 1e6
  ? `Rp ${(n/1e6).toFixed(0)} Jt`
  : `Rp ${n.toLocaleString('id-ID')}`;
