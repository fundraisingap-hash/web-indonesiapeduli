// ── DASHBOARD ────────────────────────────────────────
function renderDashboard() {
  const totalRaised   = campaigns.reduce((s,c) => s+c.raised, 0);
  const activeCamps   = campaigns.filter(c => c.status === 'aktif').length;
  const totalDonors   = campaigns.reduce((s,c) => s+c.donors, 0);
  const todayDons     = donations.filter(d => d.date.startsWith('2025-08-20')).length;

  document.getElementById('stat-total-raised').textContent = fmtRp(totalRaised);
  document.getElementById('stat-active-campaigns').textContent = activeCamps;
  document.getElementById('stat-total-donors').textContent = totalDonors.toLocaleString('id-ID');
  document.getElementById('stat-today-donations').textContent = todayDons + ' Donasi';

  // Bar chart
  const days = ['Sel','Rab','Kam','Jum','Sab','Min','Sen'];
  const vals = [18.2, 24.5, 15.8, 32.1, 28.7, 12.3, 35.6];
  const maxV = Math.max(...vals);
  const bc   = document.getElementById('bar-chart');
  bc.innerHTML = days.map((d, i) => `
    <div class="bar-group">
      <div class="bar" style="height:${(vals[i]/maxV)*110}px;" title="Rp ${vals[i]} Jt"></div>
      <div class="bar-label">${d}</div>
    </div>`).join('');

  // Recent donations
  const tbody = document.getElementById('recent-donations-body');
  tbody.innerHTML = donations.slice(0,5).map(d => `
    <tr>
      <td><div class="donor-cell"><div class="donor-initial">${escHtml(d.name[0])}</div><div><div style="font-weight:600;">${escHtml(d.name)}</div><div style="font-size:.75rem;color:var(--gray-400);">${escHtml(d.email)}</div></div></div></td>
      <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(d.campaign)}</td>
      <td class="fw-bold text-green">${fmtRpFull(d.amount)}</td>
      <td>${methodBadge(d.method)}</td>
      <td class="text-muted" style="font-size:.8rem;">${d.date}</td>
      <td>${statusBadge(d.status)}</td>
