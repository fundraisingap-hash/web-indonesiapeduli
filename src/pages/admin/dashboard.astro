// ── cell value for a column ──────────────────────────────
function donCellVal(d, colId) {
  const catMap = { kemanusiaan:'❤️ Kemanusiaan', pendidikan:'📚 Pendidikan',
    infrastruktur:'🏗️ Infrastruktur', charity:'🤲 Charity', lingkungan:'🌿 Lingkungan' };
  const camp = campaigns.find(c => c.titleId === d.campaign);
  switch(colId) {
    case 'donatur':    return `<td><div class="donor-cell"><div class="donor-initial">${escHtml(d.name[0])}</div><div><div style="font-weight:600;">${escHtml(d.name)}</div><div style="font-size:.75rem;color:var(--gray-400);">${escHtml(d.email)}</div></div></div></td>`;
    case 'status':     return `<td>${statusBadge(d.status)}</td>`;
    case 'pay_status': return `<td>${d.payStatus ? statusBadge(d.payStatus) : '<span class="text-muted">—</span>'}</td>`;
    case 'kampanye':   return `<td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.83rem;">${escHtml(d.campaign)}</td>`;
    case 'kategori':   return `<td>${camp ? catBadge(camp.category) : '<span class="text-muted">—</span>'}</td>`;
    case 'org':        return `<td style="font-size:.82rem;">${camp ? camp.org : '—'}</td>`;
    case 'pesan':      return `<td style="font-size:.8rem;color:var(--gray-500);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${d.pesan || '<span class="text-muted">—</span>'}</td>`;
    case 'anonim':     return `<td>${d.name==='Donatur Anonim'?'<span class="badge badge-gray">Anonim</span>':'<span class="badge badge-green">Publik</span>'}</td>`;
    case 'tgl_dibuat':       return `<td class="text-muted" style="font-size:.8rem;">${d.date}</td>`;
    case 'tgl_dikonfirmasi': return `<td class="text-muted" style="font-size:.8rem;">${d.status==='sukses'?d.date:'—'}</td>`;
    case 'tgl_selesai':      return `<td class="text-muted" style="font-size:.8rem;">${d.status==='sukses'?d.date:'—'}</td>`;
    case 'tgl_dibatalkan':   return `<td class="text-muted" style="font-size:.8rem;">${d.status==='gagal'?d.date:'—'}</td>`;
    case 'metode':     return `<td>${methodBadge(d.method)}</td>`;
    case 'nominal':    return `<td class="fw-bold text-green">${fmtRpFull(d.amount)}</td>`;
    case 'id_trx':     return `<td style="font-size:.75rem;font-family:monospace;">#TRX${String(d.id).padStart(6,'0')}</td>`;
    case 'gateway':    return `<td style="font-size:.82rem;">${{qris:'Midtrans',va:'Xendit',gopay:'Midtrans',ovo:'Xendit',shopeepay:'Midtrans',transfer:'Xenith'}[d.method]||'—'}</td>`;
    case 'bukti':      return `<td><span class="badge badge-gray" style="cursor:pointer;">📎 Lihat</span></td>`;
    case 'gross':      return `<td class="fw-bold">${fmtRpFull(d.amount)}</td>`;
    case 'fee_admin':  return `<td class="text-muted" style="font-size:.82rem;">${fmtRpFull({qris:0,gopay:0,shopeepay:0,va:1500,ovo:1000,transfer:2000}[d.method]||0)}</td>`;
    case 'nett':       return `<td class="fw-bold text-green">${fmtRpFull(d.amount-({qris:0,gopay:0,shopeepay:0,va:1500,ovo:1000,transfer:2000}[d.method]||0))}</td>`;
    default: return '<td>—</td>';
  }
}

function colLabel(id) { return ALL_COLS.find(c=>c.id===id)?.label || id; }

// ── render active filter chips ──────────────────────────
function renderFilterChips() {
  const wrap = document.getElementById('active-filter-chips');
  const chips = [];
  if (donFilters.method)     chips.push(['Metode: '+donFilters.method,    'method']);
  if (donFilters.status)     chips.push(['Status: '+donFilters.status,    'status']);
  if (donFilters.kampanye)   chips.push(['Kampanye: '+donFilters.kampanye,'kampanye']);
  if (donFilters.kategori)   chips.push(['Kategori: '+donFilters.kategori,'kategori']);
  if (donFilters.anonim)     chips.push(['Tipe: '+donFilters.anonim,      'anonim']);
  if (donFilters.nominalMin) chips.push([`Min: Rp ${(+donFilters.nominalMin).toLocaleString('id-ID')}`,'nominalMin']);
  if (donFilters.nominalMax) chips.push([`Max: Rp ${(+donFilters.nominalMax).toLocaleString('id-ID')}`,'nominalMax']);
  if (donFilters.dateFrom)   chips.push(['Dari: '+donFilters.dateFrom,    'dateFrom']);
  if (donFilters.dateTo)     chips.push(['Sampai: '+donFilters.dateTo,    'dateTo']);
  wrap.innerHTML = chips.map(([label,key]) =>
    `<span style="display:inline-flex;align-items:center;gap:.3rem;background:var(--blue-pale);color:#1d4ed8;border-radius:9999px;padding:.2rem .65rem;font-size:.75rem;font-weight:600;">
      ${label}
      <button onclick="clearChip('${key}')" style="background:none;border:none;cursor:pointer;font-size:.8rem;color:#1d4ed8;padding:0;line-height:1;">✕</button>
    </span>`
  ).join('');
}

function clearChip(key) {
  donFilters[key] = '';
  saveDonFilters();
  renderFilterChips();
  renderDonations();
}

// ── main render ──────────────────────────────────────────
function renderDonations() {
  const search = document.getElementById('don-search').value.toLowerCase();
  donFilters.search = search;

  let list = donations.filter(d => {
    if (search && !d.name.toLowerCase().includes(search) && !d.campaign.toLowerCase().includes(search) && !d.email.toLowerCase().includes(search)) return false;
    if (donFilters.method   && d.method   !== donFilters.method)   return false;
    if (donFilters.status   && d.status   !== donFilters.status)   return false;
    if (donFilters.kampanye && !d.campaign.toLowerCase().includes(donFilters.kampanye.toLowerCase())) return false;
    if (donFilters.anonim === 'anonim'  && d.name !== 'Donatur Anonim') return false;
    if (donFilters.anonim === 'publik'  && d.name === 'Donatur Anonim') return false;
    if (donFilters.nominalMin && d.amount < +donFilters.nominalMin) return false;
    if (donFilters.nominalMax && d.amount > +donFilters.nominalMax) return false;
    if (donFilters.dateFrom && d.date < donFilters.dateFrom) return false;
    if (donFilters.dateTo   && d.date > donFilters.dateTo + ' 99') return false;
    const camp = campaigns.find(c => c.titleId === d.campaign);
    if (donFilters.kategori && (!camp || camp.category !== donFilters.kategori)) return false;
    return true;
  });

  document.getElementById('don-count').textContent = `${list.length} Donasi`;

  // Render thead
  const thead = document.querySelector('#don-thead tr');
  thead.innerHTML = activeCols.map(id => `<th>${colLabel(id)}</th>`).join('');

  const tbody = document.getElementById('donations-table-body');
  const cols = activeCols.length || 1;
  tbody.innerHTML = list.length === 0
    ? `<tr><td colspan="${cols}" class="table-empty">Tidak ada donasi ditemukan</td></tr>`
    : list.map(d => `<tr>${activeCols.map(col => donCellVal(d, col)).join('')}</tr>`).join('');

  renderFilterChips();
}

document.getElementById('don-search').addEventListener('input', renderDonations);

// ── CUSTOMIZE COLUMNS modal logic ────────────────────────
function openColModal() {
  // Render checkboxes grouped by category
  const body = document.getElementById('col-modal-body');
  body.innerHTML = DON_COL_GROUPS.map(g => `
    <div style="margin-bottom:1rem;">
      <div style="font-weight:700;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--gray-400);margin-bottom:.6rem;padding-bottom:.4rem;border-bottom:1px solid var(--border);">${g.group}</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem .75rem;">
        ${g.cols.map(c => `
          <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.84rem;padding:.3rem .4rem;border-radius:6px;transition:background .15s;" onmouseenter="this.style.background='var(--bg)'" onmouseleave="this.style.background=''">
            <input type="checkbox" id="chk-${c.id}" value="${c.id}" ${activeCols.includes(c.id)?'checked':''} style="width:15px;height:15px;accent-color:#1aabe4;cursor:pointer;" />
            <span>${c.label}</span>
          </label>
        `).join('')}
      </div>
    </div>
  `).join('');
  openModal('col-modal');
}

function selectAllCols() {
  document.querySelectorAll('#col-modal-body input[type=checkbox]').forEach(cb => cb.checked = true);
}

function applyColumns() {
  activeCols = [...document.querySelectorAll('#col-modal-body input[type=checkbox]:checked')].map(cb => cb.value);
  if (activeCols.length === 0) activeCols = ['donatur','nominal','status'];
  saveDonCols();
  closeModal('col-modal');
  renderDonations();
  showToast('Kolom diperbarui ✅');
}

function resetCols() {
  activeCols = ALL_COLS.filter(c => c.default).map(c => c.id);
  saveDonCols();
  closeModal('col-modal');
  renderDonations();
  showToast('Kolom direset ke default');
}

// Override openModal to populate col-modal dynamically
const _origOpen = openModal;
window.openModal = function(id) {
  if (id === 'col-modal') { openColModal(); return; }
  if (id === 'filter-modal') { populateFilterModal(); _origOpen(id); return; }
  _origOpen(id);
};

// ── CUSTOMIZE FILTERS modal logic ────────────────────────
function populateFilterModal() {
  document.getElementById('ff-status').value    = donFilters.status    || '';
  document.getElementById('ff-method').value    = donFilters.method    || '';
  document.getElementById('ff-kategori').value  = donFilters.kategori  || '';
  document.getElementById('ff-anonim').value    = donFilters.anonim    || '';
  document.getElementById('ff-kampanye').value  = donFilters.kampanye  || '';
  document.getElementById('ff-date-from').value = donFilters.dateFrom  || '';
  document.getElementById('ff-date-to').value   = donFilters.dateTo    || '';
  document.getElementById('ff-min').value       = donFilters.nominalMin|| '';
  document.getElementById('ff-max').value       = donFilters.nominalMax|| '';
}

function applyFilters() {
  donFilters.status     = document.getElementById('ff-status').value;
  donFilters.method     = document.getElementById('ff-method').value;
  donFilters.kategori   = document.getElementById('ff-kategori').value;
  donFilters.anonim     = document.getElementById('ff-anonim').value;
  donFilters.kampanye   = document.getElementById('ff-kampanye').value;
  donFilters.dateFrom   = document.getElementById('ff-date-from').value;
  donFilters.dateTo     = document.getElementById('ff-date-to').value;
  donFilters.nominalMin = document.getElementById('ff-min').value;
  donFilters.nominalMax = document.getElementById('ff-max').value;
  saveDonFilters();
  closeModal('filter-modal');
  renderDonations();
  showToast('Filter diperbarui ✅');
}

function resetFilters() {
  donFilters = { search:'', method:'', status:'', kampanye:'', kategori:'', anonim:'', nominalMin:'', nominalMax:'', dateFrom:'', dateTo:'' };
  saveDonFilters();
  document.getElementById('don-search').value = '';
  closeModal('filter-modal');
  renderDonations();
  showToast('Filter direset');
}

// ── Add blue-pale CSS var if missing ─────────────────────
document.documentElement.style.setProperty('--blue-pale', '#dbeafe');

// ── DONORS TABLE ─────────────────────────────────────
function renderDonors() {
  const search = document.getElementById('donor-search').value.toLowerCase();
  let list = donors.filter(d =>
    !search || d.name.toLowerCase().includes(search) || d.email.toLowerCase().includes(search)
  );

  document.getElementById('donor-count').textContent = `${list.length} Donatur`;

  const tbody = document.getElementById('donors-table-body');
  tbody.innerHTML = list.length === 0
    ? `<tr><td colspan="6" class="table-empty">Tidak ada donatur ditemukan</td></tr>`
    : list.map(d => `<tr>
        <td><div class="donor-cell"><div class="donor-initial">${escHtml(d.name[0])}</div><span style="font-weight:600;">${d.name}</span></div></td>
        <td style="font-size:.82rem;color:var(--gray-500);">${escHtml(d.email)}</td>
        <td class="fw-bold text-green">${fmtRpFull(d.totalDonated)}</td>
        <td style="text-align:center;">${d.txCount}x</td>
        <td class="text-muted" style="font-size:.82rem;">${d.lastDate}</td>
        <td><button class="btn-action btn-view" onclick="showToast('Fitur riwayat donatur segera hadir', 'default')">👁️ Detail</button></td>
      </tr>`).join('');
}

document.getElementById('donor-search').addEventListener('input', renderDonors);

// ── WITHDRAWALS TABLE ────────────────────────────────
function renderWithdrawals() {
  const status = document.getElementById('wd-status-filter').value;
  let list = withdrawals.filter(w => !status || w.status === status);

  const tbody = document.getElementById('withdrawals-table-body');
  tbody.innerHTML = list.length === 0
    ? `<tr><td colspan="7" class="table-empty">Tidak ada permintaan penarikan</td></tr>`
    : list.map(w => `<tr>
        <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;font-size:.88rem;">${escHtml(w.campaign)}</td>
        <td style="font-size:.82rem;color:var(--gray-500);">${escHtml(w.org)}</td>
        <td class="fw-bold text-green">${fmtRpFull(w.amount)}</td>
        <td style="font-size:.8rem;">${escHtml(w.bank)}</td>
        <td class="text-muted" style="font-size:.82rem;">${w.date}</td>
        <td>${statusBadge(w.status)}</td>
        <td>
          ${w.status === 'pending' ? `
            <button class="btn-action btn-approve" onclick="approveWithdrawal(${w.id})">✅ Approve</button>
            <button class="btn-action btn-reject"  onclick="rejectWithdrawal(${w.id})">❌ Tolak</button>
          ` : '<span style="color:var(--gray-400);font-size:.8rem;">—</span>'}
        </td>
      </tr>`).join('');

  // Update badge count
  const pending = withdrawals.filter(w => w.status === 'pending').length;
  document.getElementById('withdrawal-badge').textContent = pending;
  document.getElementById('withdrawal-badge').style.display = pending ? 'inline' : 'none';
}

document.getElementById('wd-status-filter').addEventListener('change', renderWithdrawals);

function approveWithdrawal(id) {
  const w = withdrawals.find(x => x.id === id);
  showConfirm('✅','Setujui Penarikan',`Penarikan sebesar ${fmtRpFull(w.amount)} untuk "${escHtml(w.campaign)}" akan disetujui.`,'Ya, Setujui', () => {
    const idx = withdrawals.findIndex(x => x.id === id);
    withdrawals[idx].status = 'approved';
    saveData(); renderWithdrawals();
    showToast('✅ Penarikan dana disetujui', 'success');
  });
}

function rejectWithdrawal(id) {
  const w = withdrawals.find(x => x.id === id);
  showConfirm('❌','Tolak Penarikan',`Penarikan sebesar ${fmtRpFull(w.amount)} untuk "${escHtml(w.campaign)}" akan ditolak.`,'Ya, Tolak', () => {
    const idx = withdrawals.findIndex(x => x.id === id);
    withdrawals[idx].status = 'rejected';
    saveData(); renderWithdrawals();
    showToast('Penarikan ditolak', 'error');
  });
}

// ── CATEGORIES ───────────────────────────────────────
function renderCategories() {
  const container = document.getElementById('cat-tags-container');
  container.innerHTML = categories.map((c, i) => `
    <div class="cat-tag">
      ${c.emoji} ${c.name}
      <button class="cat-tag-remove" onclick="removeCategory(${i})" title="Hapus">✕</button>
    </div>`).join('');
}

function addCategory() {
  const emoji = document.getElementById('cat-new-emoji').value.trim() || '📌';
  const name  = document.getElementById('cat-new-name').value.trim();
  if (!name) { showToast('Isi nama kategori', 'error'); return; }
  categories.push({ emoji, name });
  document.getElementById('cat-new-emoji').value = '';
  document.getElementById('cat-new-name').value  = '';
  saveData(); renderCategories();
  showToast(`Kategori "${name}" ditambahkan`, 'success');
}

function removeCategory(i) {
  showConfirm('🗑️','Hapus Kategori',`"${categories[i].name}" akan dihapus.`,'Ya, Hapus', () => {
    categories.splice(i, 1);
    saveData(); renderCategories();
    showToast('Kategori dihapus', 'error');
  });
}

// ── SETTINGS ─────────────────────────────────────────
function saveSettings() {
  const settings = {
    siteName: document.getElementById('cfg-site-name').value,
    tagline:  document.getElementById('cfg-tagline').value,
    email:    document.getElementById('cfg-email').value,
    whatsapp: document.getElementById('cfg-whatsapp').value,
    address:  document.getElementById('cfg-address').value,
  };
  localStorage.setItem('ips_settings', JSON.stringify(settings));
  showToast('✅ Pengaturan berhasil disimpan', 'success');
}

function changePassword() {
  const u       = document.getElementById('cfg-admin-user').value.trim();
  const oldPass = document.getElementById('cfg-old-pass').value;
  const newPass = document.getElementById('cfg-new-pass').value;
  const confirm = document.getElementById('cfg-confirm-pass').value;

  const storedPass = localStorage.getItem('ips_admin_pass') || 'admin123';

  if (oldPass !== storedPass) { showToast('Password lama salah', 'error'); return; }
  if (newPass.length < 6)     { showToast('Password baru minimal 6 karakter', 'error'); return; }
  if (newPass !== confirm)    { showToast('Konfirmasi password tidak cocok', 'error'); return; }

  localStorage.setItem('ips_admin_user', u || 'admin');
  localStorage.setItem('ips_admin_pass', newPass);
  document.getElementById('cfg-old-pass').value = '';
  document.getElementById('cfg-new-pass').value = '';
  document.getElementById('cfg-confirm-pass').value = '';
  showToast('✅ Password berhasil diubah', 'success');
}

// ── EXPORT ───────────────────────────────────────────
function exportCSV() {
  const header = ['ID','Donatur','Email','Kampanye','Nominal','Metode','Status','Tanggal'];
  const rows   = donations.map(d => [d.id, d.name, d.email, d.campaign, d.amount, d.method, d.status, d.date]);
  const csv    = [header, ...rows].map(r => r.join(',')).join('\n');
  const blob   = new Blob([csv], { type:'text/csv' });
  const a      = document.createElement('a');
  a.href       = URL.createObjectURL(blob);
  a.download   = `donasi-${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  showToast('✅ CSV berhasil diexport', 'success');
}

function exportReport() {
  showToast('📥 Laporan sedang diproses...', 'default');
  setTimeout(() => showToast('✅ Laporan berhasil didownload', 'success'), 1500);
}

// ── Init ─────────────────────────────────────────────
function init() {
  // Load saved settings
  const saved = JSON.parse(localStorage.getItem('ips_settings') || '{}');
  if (saved.siteName) document.getElementById('cfg-site-name').value = saved.siteName;
  if (saved.tagline)  document.getElementById('cfg-tagline').value   = saved.tagline;
  if (saved.email)    document.getElementById('cfg-email').value     = saved.email;
  if (saved.whatsapp) document.getElementById('cfg-whatsapp').value  = saved.whatsapp;
  if (saved.address)  document.getElementById('cfg-address').value   = saved.address;

  document.getElementById('cfg-admin-user').value = localStorage.getItem('ips_admin_user') || 'admin';

  renderDashboard();
  renderCampaigns();
  renderDonations();
  renderDonors();
  renderWithdrawals();
  renderCategories();
}
init();
// ── FUNDRAISER TABLE FILTER ──────────────────────────
function filterFundraisers() {
  const search   = (document.getElementById('fr-search').value || '').toLowerCase();
  const status   = (document.getElementById('fr-status-filter').value || '').toLowerCase();
  const campaign = (document.getElementById('fr-campaign-filter').value || '').toLowerCase();
  const rows     = document.querySelectorAll('#fundraisers-table-body tr');
  let visible = 0;
  rows.forEach(row => {
    const name = (row.dataset.name || '').toLowerCase();
    const st   = (row.dataset.status || '').toLowerCase();
    const cam  = (row.dataset.campaign || '').toLowerCase();
    const matchSearch   = !search   || name.includes(search);
    const matchStatus   = !status   || st === status;
    const matchCampaign = !campaign || cam === campaign;
    const show = matchSearch && matchStatus && matchCampaign;
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('fr-count').textContent = `Semua Fundraiser (${visible})`;
}
document.getElementById('fr-search').addEventListener('input', filterFundraisers);
document.getElementById('fr-status-filter').addEventListener('change', filterFundraisers);
document.getElementById('fr-campaign-filter').addEventListener('change', filterFundraisers);

</script>
