// ── CAMPAIGNS TABLE ──────────────────────────────────
function renderCampaigns() {
  const search = document.getElementById('camp-search').value.toLowerCase();
  const cat    = document.getElementById('camp-cat-filter').value;
  const status = document.getElementById('camp-status-filter').value;

  let list = campaigns.filter(c =>
    (!search || c.titleId.toLowerCase().includes(search)) &&
    (!cat    || c.category === cat) &&
    (!status || c.status   === status)
  );

  document.getElementById('camp-count').textContent = `${list.length} Kampanye`;

  const tbody = document.getElementById('campaigns-table-body');
  tbody.innerHTML = list.length === 0
    ? `<tr><td colspan="8" class="table-empty">Tidak ada kampanye ditemukan</td></tr>`
    : list.map(c => {
      const p = pct(c.raised, c.target);
      return `<tr>
        <td style="max-width:180px;">
          <div style="font-weight:700;font-size:.88rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(c.titleId)}</div>
          <div style="font-size:.75rem;color:var(--gray-400);">${escHtml(c.org)}</div>
        </td>
        <td>${catBadge(c.category)}</td>
        <td style="font-size:.82rem;">${fmtRp(c.target)}</td>
        <td class="fw-bold text-green" style="font-size:.88rem;">${fmtRp(c.raised)}</td>
        <td>
          <div style="display:flex;align-items:center;gap:.5rem;">
            <div class="mini-progress"><div class="mini-progress-bar" style="width:${p}%;"></div></div>
            <span style="font-size:.78rem;font-weight:700;color:var(--green);">${p}%</span>
          </div>
        </td>
        <td style="font-size:.82rem;">${c.donors.toLocaleString('id-ID')}</td>
        <td>${statusBadge(c.status)}</td>
        <td>
          <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
            <button class="btn-action btn-edit" onclick="editCampaign(${c.id})">✏️ Edit</button>
            <button class="btn-action btn-delete" onclick="deleteCampaign(${c.id})">🗑️</button>
          </div>
        </td>
      </tr>`;
    }).join('');
}

['camp-search','camp-cat-filter','camp-status-filter'].forEach(id => {
  document.getElementById(id).addEventListener('input', renderCampaigns);
  document.getElementById(id).addEventListener('change', renderCampaigns);
});

// Add campaign
document.getElementById('btn-add-campaign').addEventListener('click', () => {
  document.getElementById('campaign-modal-title').textContent = '➕ Tambah Kampanye Baru';
  document.getElementById('modal-campaign-id').value = '';
  ['modal-title-id','modal-title-en','modal-desc-id','modal-org','modal-image'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('modal-target').value = '';
  document.getElementById('modal-days').value = '30';
  document.getElementById('modal-category').value = 'kemanusiaan';
  document.getElementById('modal-status').value = 'draft';
  document.getElementById('modal-urgent').checked = false;
  openModal('campaign-modal');
});

function editCampaign(id) {
  const c = campaigns.find(x => x.id === id);
  if (!c) return;
  document.getElementById('campaign-modal-title').textContent = '✏️ Edit Kampanye';
  document.getElementById('modal-campaign-id').value = id;
  document.getElementById('modal-title-id').value   = c.titleId;
  document.getElementById('modal-title-en').value   = c.titleEn || '';
  document.getElementById('modal-desc-id').value    = c.descId || '';
  document.getElementById('modal-target').value     = c.target;
  document.getElementById('modal-days').value       = c.daysLeft;
  document.getElementById('modal-org').value        = c.org;
  document.getElementById('modal-image').value      = c.image || '';
  document.getElementById('modal-category').value   = c.category;
  document.getElementById('modal-status').value     = c.status;
  document.getElementById('modal-urgent').checked   = c.urgent || false;
  openModal('campaign-modal');
}

function saveCampaign() {
  const id     = document.getElementById('modal-campaign-id').value;
  const titleId = document.getElementById('modal-title-id').value.trim();
  if (!titleId) { showToast('Judul kampanye wajib diisi', 'error'); return; }

  const data = {
    titleId, titleEn: document.getElementById('modal-title-en').value,
    descId: document.getElementById('modal-desc-id').value,
    category: document.getElementById('modal-category').value,
    status:   document.getElementById('modal-status').value,
    target:   +document.getElementById('modal-target').value || 0,
    daysLeft: +document.getElementById('modal-days').value  || 30,
    org:      document.getElementById('modal-org').value,
    image:    document.getElementById('modal-image').value,
    urgent:   document.getElementById('modal-urgent').checked,
  };

  if (id) {
    const idx = campaigns.findIndex(c => c.id === +id);
    if (idx > -1) { campaigns[idx] = {...campaigns[idx], ...data}; }
    showToast('✅ Kampanye berhasil diperbarui', 'success');
  } else {
    const newId = Math.max(0, ...campaigns.map(c => c.id)) + 1;
    campaigns.push({ id: newId, slug: titleId.toLowerCase().replace(/\s+/g,'-'), raised: 0, donors: 0, ...data });
    showToast('✅ Kampanye baru berhasil ditambahkan', 'success');
  }
  saveData(); closeModal('campaign-modal'); renderCampaigns(); renderDashboard();
}

function deleteCampaign(id) {
  const c = campaigns.find(x => x.id === id);
  showConfirm('🗑️','Hapus Kampanye',`"${escHtml(c.titleId)}" akan dihapus secara permanen.`,'Ya, Hapus', () => {
    campaigns = campaigns.filter(x => x.id !== id);
    saveData(); renderCampaigns(); renderDashboard();
    showToast('Kampanye berhasil dihapus', 'error');
  });
}

