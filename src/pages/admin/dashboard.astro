// ── DASHBOARD ────────────────────────────────────────
function renderDashboard() {
  const totalRaised   = campaigns.reduce((s,c) => s+c.raised, 0);
  const activeCamps   = campaigns.filter(c => c.status === 'aktif').length;
  const totalDonors   = campaigns.reduce((s,c) => s+c.donors, 0);
  const todayDons     = donations.filter(d => d.date.startsWith('2025-08-20')).length;

  document.getElementById('stat-total-raised').textContent = fmtRp(totalRaised);
  document.getElementById('stat-active-campaigns').textContent = activeCamps;
  document.getElementById('stat-total-donors').textContent = totalDonors.toLocaleString('id-ID');
  document.getElementById('stat-today-donations').textContent = todayDons + ' Donasi';

  // Bar chart
  const days = ['Sel','Rab','Kam','Jum','Sab','Min','Sen'];
  const vals = [18.2, 24.5, 15.8, 32.1, 28.7, 12.3, 35.6];
  const maxV = Math.max(...vals);
  const bc   = document.getElementById('bar-chart');
  bc.innerHTML = days.map((d, i) => `
    <div class="bar-group">
      <div class="bar" style="height:${(vals[i]/maxV)*110}px;" title="Rp ${vals[i]} Jt"></div>
      <div class="bar-label">${d}</div>
    </div>`).join('');

  // Recent donations
  const tbody = document.getElementById('recent-donations-body');
  tbody.innerHTML = donations.slice(0,5).map(d => `
    <tr>
      <td><div class="donor-cell"><div class="donor-initial">${escHtml(d.name[0])}</div><div><div style="font-weight:600;">${escHtml(d.name)}</div><div style="font-size:.75rem;color:var(--gray-400);">${escHtml(d.email)}</div></div></div></td>
      <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(d.campaign)}</td>
      <td class="fw-bold text-green">${fmtRpFull(d.amount)}</td>
      <td>${methodBadge(d.method)}</td>
      <td class="text-muted" style="font-size:.8rem;">${d.date}</td>
      <td>${statusBadge(d.status)}</td>
    </tr>`).join('');

  // Withdrawal badge
  const pending = withdrawals.filter(w => w.status === 'pending').length;
  document.getElementById('withdrawal-badge').textContent = pending;
  document.getElementById('withdrawal-badge').style.display = pending ? 'inline' : 'none';
}

// ── CAMPAIGNS TABLE ──────────────────────────────────
function renderCampaigns() {
  const search = document.getElementById('camp-search').value.toLowerCase();
  const cat    = document.getElementById('camp-cat-filter').value;
  const status = document.getElementById('camp-status-filter').value;

  let list = campaigns.filter(c =>
    (!search || c.titleId.toLowerCase().includes(search)) &&
    (!cat    || c.category === cat) &&
    (!status || c.status   === status)
  );

  document.getElementById('camp-count').textContent = `${list.length} Kampanye`;

  // Update stat cards
  document.getElementById('camp-stat-total').textContent = list.length;
  const totalTarget = list.reduce((sum, c) => sum + (c.target || 0), 0);
  const totalRaised = list.reduce((sum, c) => sum + (c.raised || 0), 0);
  document.getElementById('camp-stat-target').textContent = fmtRpFull(totalTarget);
  document.getElementById('camp-stat-raised').textContent = fmtRpFull(totalRaised);
  const avgProgress = list.length > 0 ? (totalRaised / (totalTarget || 1) * 100) : 0;
  document.getElementById('camp-stat-avg-progress').textContent = `${isNaN(avgProgress) || !isFinite(avgProgress) ? 0 : Math.round(avgProgress)}%`;

  const tbody = document.getElementById('campaigns-table-body');
  tbody.innerHTML = list.length === 0
    ? `<tr><td colspan="8" class="table-empty">Tidak ada kampanye ditemukan</td></tr>`
    : list.map(c => {
      const p = pct(c.raised, c.target);
      
      let pColor = 'var(--red)';
      if (p >= 75) pColor = 'var(--green)';
      else if (p >= 40) pColor = 'var(--amber)';

      const bgColors = ['#f59e0b', '#3b82f6', '#10b981', '#8b5cf6', '#ef4444'];
      const bg = bgColors[c.id % bgColors.length];
      const thumbHtml = c.image 
        ? `<img src="${c.image}" class="camp-thumb" alt="Cover" />` 
        : `<div class="camp-initial" style="background:${bg};">${c.titleId.charAt(0).toUpperCase()}</div>`;

      let statusDotColor = '#94a3b8';
      let statusText = escHtml(c.status);
      let statusBg = 'var(--gray-100)';
      let statusColor = 'var(--gray-600)';
      if(c.status === 'aktif') {
        statusDotColor = '#10b981';
        statusBg = 'var(--green-pale)';
        statusColor = 'var(--green)';
        statusText = 'Aktif';
      } else if (c.status === 'draft') {
        statusDotColor = '#94a3b8';
        statusBg = 'var(--gray-100)';
        statusColor = 'var(--gray-600)';
        statusText = 'Draft';
      } else if (c.status === 'selesai') {
        statusDotColor = '#3b82f6';
        statusBg = 'var(--blue-pale)';
        statusColor = '#1d4ed8';
        statusText = 'Selesai';
      }
      const statusHtml = `<span class="badge" style="background:${statusBg};color:${statusColor};"><div style="width:6px;height:6px;border-radius:50%;background:${statusDotColor};margin-right:2px;"></div>${statusText}</span>`;

      const daysLeft = c.endDate ? Math.ceil((new Date(c.endDate) - new Date()) / (1000 * 60 * 60 * 24)) : 30;

      return `<tr>
        <td>
          <div style="display:flex;align-items:center;gap:1rem;">
            ${thumbHtml}
            <div style="max-width:200px;">
              <div style="font-weight:700;font-size:.88rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--gray-900);">${escHtml(c.titleId)}</div>
              <div style="font-size:.75rem;color:var(--gray-500);font-weight:500;">${escHtml(c.org)}</div>
            </div>
          </div>
        </td>
        <td>${catBadge(c.category)}</td>
        <td style="font-size:.82rem;">${fmtRp(c.target)}</td>
        <td class="fw-bold" style="font-size:.88rem;color:var(--green);">${fmtRp(c.raised)}</td>
        <td>
          <div style="display:flex;align-items:center;gap:.6rem;">
            <div class="mini-progress"><div class="mini-progress-bar" style="width:${p}%; background:${pColor};"></div></div>
            <span style="font-size:.78rem;font-weight:800;color:${pColor};">${p}%</span>
          </div>
        </td>
        <td style="font-size:.82rem;font-weight:600;color:var(--gray-600);">${Math.max(0, daysLeft)} Hari</td>
        <td>${statusHtml}</td>
        <td>
          <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
            <a href="/campaigns/${c.slug || c.id}" class="btn-action btn-view" style="text-decoration:none;" title="View">👁️</a>
            <button class="btn-action btn-edit" title="Edit" onclick="editCampaign(${c.id})">✏️</button>
            <button class="btn-action btn-view" title="Stats">📊</button>
            <button class="btn-action btn-delete" title="Delete" onclick="deleteCampaign(${c.id})">🗑️</button>
          </div>
        </td>
      </tr>`;
    }).join('');
}

['camp-search','camp-cat-filter','camp-status-filter'].forEach(id => {
  document.getElementById(id).addEventListener('input', renderCampaigns);
  document.getElementById(id).addEventListener('change', renderCampaigns);
});

// ── CAMPAIGN RICH EDITOR ─────────────────────────────
let quillEditor = null;
let coverImageData = null; // base64 or URL

function initQuill() {
  if (quillEditor) return;

  const editorEl = document.getElementById('ce-quill-editor');
  if (!editorEl) { console.error('ce-quill-editor not found'); return; }
  if (typeof Quill === 'undefined') { setTimeout(initQuill, 300); return; }

  console.log('[CampaignEditor] Initializing Quill...');

  quillEditor = new Quill('#ce-quill-editor', {
    theme: 'snow',
    placeholder: 'Tuliskan cerita lengkap kampanye di sini...\n\nCeritakan situasi nyata, dampak yang diharapkan, dan bagaimana donasi akan digunakan.',
    modules: {
      toolbar: [
        [{ header: [1, 2, 3, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        [{ indent: '-1' }, { indent: '+1' }],
        ['link', 'image', 'video'],
        [{ align: [] }],
        [{ color: [] }, { background: [] }],
        ['clean'],
      ],
    },
  });

  // Custom image handler — use file input instead of URL prompt
  quillEditor.getModule('toolbar').addHandler('image', function() {
    document.getElementById('ce-inline-img-input').click();
  });

  console.log('[CampaignEditor] Quill ready ✓');
}

// Image upload handler (attached once at page load, not inside initQuill)
document.getElementById('ce-inline-img-input').addEventListener('change', function() {
  const file = this.files[0];
  if (!file) return;
  if (file.size > 2097152) {
    showToast('⚠️ Gambar melebihi 2MB', 'error');
    this.value = '';
    return;
  }
  const reader = new FileReader();
  reader.onload = (e) => {
    if (!quillEditor) return;
    const range = quillEditor.getSelection(true);
    quillEditor.insertEmbed(range.index, 'image', e.target.result);
    quillEditor.setSelection(range.index + 1);
  };
  reader.readAsDataURL(file);
  this.value = '';
});

function openCampaignEditor() {
  const overlay = document.getElementById('campaign-modal');
  overlay.classList.add('open');
  document.body.style.overflow = 'hidden';
  // Init Quill after modal is visible
  setTimeout(initQuill, 150);
}

function closeCampaignEditor() {
  document.getElementById('campaign-modal').classList.remove('open');
  document.body.style.overflow = '';
}

function clearCampaignEditor() {
  document.getElementById('modal-campaign-id').value = '';
  document.getElementById('modal-title-id').value = '';
  document.getElementById('modal-title-en').value = '';
  document.getElementById('modal-desc-id').value = '';
  document.getElementById('modal-desc-main').value = '';
  document.getElementById('modal-target').value = '';
  document.getElementById('modal-days').value = '30';
  document.getElementById('modal-org').value = '';
  document.getElementById('modal-category').value = 'kemanusiaan';
  document.getElementById('modal-status').value = 'draft';
  document.getElementById('modal-urgent').checked = false;
  coverImageData = null;
  document.getElementById('ce-cover-img').style.display = 'none';
  document.getElementById('ce-cover-placeholder').style.display = '';
  document.getElementById('ce-cover-hover-overlay').style.display = 'none';
  if (quillEditor) quillEditor.setContents([]);
  document.getElementById('ce-desc-count').textContent = '0';
  document.getElementById('ce-desc-count-main').textContent = '0';
}

// Cover image upload
document.getElementById('ce-cover-preview').addEventListener('click', (e) => {
  document.getElementById('ce-cover-input').click();
});
document.getElementById('ce-cover-input').addEventListener('change', function() {
  const file = this.files[0];
