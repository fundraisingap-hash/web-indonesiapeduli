---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Tentang Kami — Indonesia Peduli Sesama"
  description="Indonesia Peduli Sesama adalah platform donasi online terpercaya yang menghubungkan donatur dengan kampanye sosial di seluruh Indonesia."
>

  <!-- About Hero -->
  <section class="about-hero">
    <div style="position:relative;z-index:1;">
      <div class="section-badge" style="background:rgba(245,158,11,.2);color:#fde68a;border:1px solid rgba(245,158,11,.3);margin-bottom:1rem;">
        🤝 Indonesia Peduli Sesama
      </div>
      <h1 data-i18n-about="title">Tentang Kami</h1>
      <p data-i18n-about="subtitle">
        Platform donasi online terpercaya yang menghubungkan kebaikan hati donatur dengan mereka yang membutuhkan di seluruh penjuru Indonesia.
      </p>
    </div>
    <!-- Decorative circles -->
    <div style="position:absolute;width:400px;height:400px;border-radius:50%;background:rgba(22,163,74,.1);top:-100px;right:-100px;pointer-events:none;"></div>
    <div style="position:absolute;width:200px;height:200px;border-radius:50%;background:rgba(245,158,11,.1);bottom:-50px;left:5%;pointer-events:none;"></div>
  </section>

  <!-- Visi Misi -->
  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div>
          <img src="/images/hero-banner.jpg" alt="Tim Indonesia Peduli Sesama" class="about-img animate-on-scroll" />
        </div>
        <div>
          <div class="section-badge animate-on-scroll">🌟 Visi & Misi</div>
          <h2 class="animate-on-scroll" data-i18n-about="vm-title">Membangun Indonesia yang Saling Peduli</h2>
          <p class="animate-on-scroll" style="margin-bottom:2rem;" data-i18n-about="vm-desc">
            Kami percaya bahwa setiap orang memiliki kemampuan untuk membuat perubahan. Dengan teknologi dan kepercayaan, kami menghubungkan kepedulian dengan dampak nyata.
          </p>
          <div class="about-features">
            <div class="about-feature animate-on-scroll">
              <div class="about-feature__icon">🎯</div>
              <div>
                <div class="about-feature__title" data-i18n-about="f1-title">Visi</div>
                <div class="about-feature__desc" data-i18n-about="f1-desc">Menjadi platform donasi online #1 di Indonesia yang paling transparan dan terpercaya.</div>
              </div>
            </div>
            <div class="about-feature animate-on-scroll">
              <div class="about-feature__icon">🚀</div>
              <div>
                <div class="about-feature__title" data-i18n-about="f2-title">Misi</div>
                <div class="about-feature__desc" data-i18n-about="f2-desc">Memfasilitasi 1 juta donasi dan menyalurkan Rp 1 Triliun untuk kebaikan Indonesia pada 2030.</div>
              </div>
            </div>
            <div class="about-feature animate-on-scroll">
              <div class="about-feature__icon">💎</div>
              <div>
                <div class="about-feature__title" data-i18n-about="f3-title">Nilai</div>
                <div class="about-feature__desc" data-i18n-about="f3-desc">Transparansi, Integritas, Empati, dan Dampak Nyata adalah fondasi setiap langkah kami.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Strip -->
  <section style="background:var(--color-primary);padding:3rem 0;">
    <div class="container">
      <div class="stats-grid" style="color:white;">
        <div class="stat-card animate-on-scroll">
          <div class="stat-card__icon">📅</div>
          <span class="stat-card__num">2019</span>
          <div class="stat-card__label" data-i18n-about="year-label">Tahun Berdiri</div>
        </div>
        <div class="stat-card animate-on-scroll">
          <div class="stat-card__icon">👥</div>
          <span class="stat-card__num">127K+</span>
          <div class="stat-card__label" data-i18n-about="donors-label">Donatur</div>
        </div>
        <div class="stat-card animate-on-scroll">
          <div class="stat-card__icon">💰</div>
          <span class="stat-card__num">Rp 48M</span>
          <div class="stat-card__label" data-i18n-about="raised-label">Dana Tersalurkan</div>
        </div>
        <div class="stat-card animate-on-scroll">
          <div class="stat-card__icon">🏆</div>
          <span class="stat-card__num">342+</span>
          <div class="stat-card__label" data-i18n-about="campaigns-label">Kampanye Sukses</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cara Kerja -->
  <section class="section">
    <div class="container">
      <div class="section-badge animate-on-scroll">⚙️ Cara Kerja</div>
      <h2 class="section-title animate-on-scroll" data-i18n-about="how-title">Bagaimana Kami Bekerja</h2>
      <p class="section-subtitle animate-on-scroll" data-i18n-about="how-subtitle">
        Setiap donasi diverifikasi, disalurkan, dan dilaporkan secara transparan
      </p>

      <div class="grid grid-3" style="margin-top:2.5rem;">
        <div class="animate-on-scroll" style="background:var(--color-white);border:1px solid var(--color-gray-100);border-radius:var(--radius-lg);padding:2rem;text-align:center;transition:all .25s;box-shadow:var(--shadow-sm);">
          <div style="font-size:2.5rem;margin-bottom:1rem;">🔍</div>
          <h3 style="font-size:1.1rem;margin-bottom:.5rem;" data-i18n-about="hw1-title">Verifikasi Kampanye</h3>
          <p style="font-size:.9rem;color:var(--color-gray-500);" data-i18n-about="hw1-desc">Setiap kampanye diverifikasi tim kami dalam 1-3 hari kerja sebelum dipublikasikan.</p>
        </div>
        <div class="animate-on-scroll" style="background:var(--color-white);border:1px solid var(--color-gray-100);border-radius:var(--radius-lg);padding:2rem;text-align:center;transition:all .25s;box-shadow:var(--shadow-sm);">
          <div style="font-size:2.5rem;margin-bottom:1rem;">💳</div>
          <h3 style="font-size:1.1rem;margin-bottom:.5rem;" data-i18n-about="hw2-title">Pembayaran Aman</h3>
          <p style="font-size:.9rem;color:var(--color-gray-500);" data-i18n-about="hw2-desc">Dana masuk ke rekening escrow terpisah dan tidak digunakan hingga kampanye terverifikasi.</p>
        </div>
        <div class="animate-on-scroll" style="background:var(--color-white);border:1px solid var(--color-gray-100);border-radius:var(--radius-lg);padding:2rem;text-align:center;transition:all .25s;box-shadow:var(--shadow-sm);">
          <div style="font-size:2.5rem;margin-bottom:1rem;">📊</div>
          <h3 style="font-size:1.1rem;margin-bottom:.5rem;" data-i18n-about="hw3-title">Laporan Transparan</h3>
          <p style="font-size:.9rem;color:var(--color-gray-500);" data-i18n-about="hw3-desc">Penggalang dana wajib membuat laporan penggunaan dana yang dapat dilihat publik.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section" style="background:var(--color-gray-50);">
    <div class="container">
      <div class="section-badge animate-on-scroll">👋 Tim Kami</div>
      <h2 class="section-title animate-on-scroll" data-i18n-about="team-title">Orang-orang di Balik Indonesia Peduli Sesama</h2>
      <p class="section-subtitle animate-on-scroll" data-i18n-about="team-subtitle">Tim berdedikasi yang bekerja setiap hari untuk misi kebaikan</p>

      <div class="team-grid" style="margin-top:2.5rem;">
        {[
          { initial:'AR', name:'Ahmad Rizal', role:'CEO & Co-founder' },
          { initial:'DS', name:'Dewi Sartika', role:'COO & Co-founder' },
          { initial:'FN', name:'Fajar Nugroho', role:'CTO' },
          { initial:'RL', name:'Rina Lestari', role:'Head of Campaigns' },
          { initial:'BP', name:'Budi Prayogo', role:'Head of Finance' },
          { initial:'SI', name:'Siti Indriani', role:'Head of Partnerships' },
          { initial:'YP', name:'Yusuf Pratama', role:'Lead Engineer' },
          { initial:'MA', name:'Maya Anggraini', role:'Community Manager' },
        ].map((member, i) => (
          <div class="team-card animate-on-scroll" style={`animation-delay:${i*0.08}s`} id={`team-${i}`}>
            <div class="team-card__avatar">{member.initial}</div>
            <div class="team-card__name">{member.name}</div>
            <div class="team-card__role">{member.role}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Legal & Trust -->
  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div>
          <div class="section-badge animate-on-scroll">⚖️ Legal & Kepercayaan</div>
          <h2 class="animate-on-scroll" data-i18n-about="legal-title">Kami Beroperasi Secara Legal dan Transparan</h2>
          <div class="about-features" style="margin-top:1.5rem;">
            {[
              { icon:'📜', title:'Terdaftar Kemenkumham', desc:'SK Menkumham No. AHU-0012345.AH.01.07.Tahun 2019' },
              { icon:'🏛️', title:'Mitra OJK', desc:'Terdaftar sebagai penyelenggara layanan urun dana (crowdfunding) di OJK' },
              { icon:'🔒', title:'ISO 27001 Certified', desc:'Sertifikasi keamanan informasi internasional untuk perlindungan data Anda' },
              { icon:'💼', title:'Audit Tahunan', desc:'Laporan keuangan diaudit oleh kantor akuntan publik independen setiap tahun' },
            ].map((item, i) => (
              <div class="about-feature animate-on-scroll" style={`animation-delay:${i*0.1}s`} id={`legal-${i}`}>
                <div class="about-feature__icon">{item.icon}</div>
                <div>
                  <div class="about-feature__title" data-i18n-legal-t={i}>{item.title}</div>
                  <div class="about-feature__desc" data-i18n-legal-d={i}>{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <!-- Contact card -->
          <div style="background:linear-gradient(135deg,var(--color-primary-dark),var(--color-gray-900));border-radius:var(--radius-xl);padding:2.5rem;color:white;">
            <h3 style="color:white;margin-bottom:1.5rem;" data-i18n-about="contact-title">Hubungi Kami</h3>
            <div style="display:flex;flex-direction:column;gap:1.25rem;">
              {[
                { icon:'📧', label:'Email', value:'hello@indonesiapedulisesama.org' },
                { icon:'📱', label:'WhatsApp', value:'+62 812-3456-7890' },
                { icon:'📍', label:'Alamat', value:'Jl. Sudirman No. 123, Jakarta Pusat 10220' },
                { icon:'⏰', label:'Jam Operasional', value:'Senin-Jumat, 08.00-17.00 WIB' },
              ].map((c, i) => (
                <div style="display:flex;gap:1rem;align-items:flex-start;" id={`contact-${i}`}>
                  <span style="font-size:1.25rem;margin-top:.1rem;">{c.icon}</span>
                  <div>
                    <div style="font-size:.8rem;opacity:.7;">{c.label}</div>
                    <div style="font-weight:600;">{c.value}</div>
                  </div>
                </div>
              ))}
            </div>
            <a href="#" class="btn btn--ghost btn--full" style="margin-top:2rem;" id="btn-contact">
              💬 Kirim Pesan
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section style="padding:3rem 0;background:var(--color-gray-50);border-top:1px solid var(--color-gray-200);">
    <div class="container">
      <p class="text-center" style="color:var(--color-gray-400);font-size:.85rem;margin-bottom:2rem;text-transform:uppercase;letter-spacing:.1em;" data-i18n-about="partners-label">
        Dipercaya & Didukung oleh
      </p>
      <div class="payment-logos">
        {['BAZNAS', 'UNICEF', 'WHO', 'Kemsos RI', 'BNPB', 'UNHCR'].map((p, i) => (
          <div class="payment-logo-item" style="color:var(--color-gray-600);" id={`partner-${i}`}>{p}</div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script>
  const applyLang = (lang: string) => {
    const t: Record<string, Record<string,string>> = {
      id: {
        title:'Tentang Kami',
        subtitle:'Platform donasi online terpercaya yang menghubungkan kebaikan hati donatur dengan mereka yang membutuhkan.',
        'vm-title':'Membangun Indonesia yang Saling Peduli',
        'vm-desc':'Kami percaya bahwa setiap orang memiliki kemampuan untuk membuat perubahan.',
        'f1-title':'Visi','f1-desc':'Menjadi platform donasi online #1 di Indonesia yang paling transparan dan terpercaya.',
        'f2-title':'Misi','f2-desc':'Memfasilitasi 1 juta donasi dan menyalurkan Rp 1 Triliun untuk kebaikan Indonesia pada 2030.',
        'f3-title':'Nilai','f3-desc':'Transparansi, Integritas, Empati, dan Dampak Nyata.',
        'year-label':'Tahun Berdiri','donors-label':'Donatur','raised-label':'Dana Tersalurkan','campaigns-label':'Kampanye Sukses',
        'how-title':'Bagaimana Kami Bekerja','how-subtitle':'Setiap donasi diverifikasi, disalurkan, dan dilaporkan secara transparan',
        'hw1-title':'Verifikasi Kampanye','hw1-desc':'Setiap kampanye diverifikasi tim kami dalam 1-3 hari kerja sebelum dipublikasikan.',
        'hw2-title':'Pembayaran Aman','hw2-desc':'Dana masuk ke rekening escrow terpisah dan tidak digunakan hingga kampanye terverifikasi.',
        'hw3-title':'Laporan Transparan','hw3-desc':'Penggalang dana wajib membuat laporan penggunaan dana yang dapat dilihat publik.',
        'team-title':'Orang-orang di Balik Indonesia Peduli Sesama','team-subtitle':'Tim berdedikasi yang bekerja setiap hari untuk misi kebaikan',
        'legal-title':'Kami Beroperasi Secara Legal dan Transparan',
        'contact-title':'Hubungi Kami',
        'partners-label':'Dipercaya & Didukung oleh',
      },
      en: {
        title:'About Us',
        subtitle:'A trusted online donation platform connecting donors with those in need across Indonesia.',
        'vm-title':'Building a Caring Indonesia',
        'vm-desc':'We believe everyone has the ability to make a difference.',
        'f1-title':'Vision','f1-desc':'To become Indonesia\'s most transparent and trusted #1 donation platform.',
        'f2-title':'Mission','f2-desc':'Facilitate 1 million donations and channel Rp 1 Trillion for Indonesia by 2030.',
        'f3-title':'Values','f3-desc':'Transparency, Integrity, Empathy, and Real Impact.',
        'year-label':'Founded','donors-label':'Donors','raised-label':'Funds Channeled','campaigns-label':'Successful Campaigns',
        'how-title':'How We Work','how-subtitle':'Every donation is verified, distributed, and reported transparently',
        'hw1-title':'Campaign Verification','hw1-desc':'Every campaign is verified by our team within 1-3 business days before publishing.',
        'hw2-title':'Secure Payment','hw2-desc':'Funds go into a separate escrow account and are not used until the campaign is verified.',
        'hw3-title':'Transparent Reporting','hw3-desc':'Fundraisers must create fund usage reports viewable by the public.',
        'team-title':'People Behind Indonesia Peduli Sesama','team-subtitle':'A dedicated team working every day for the mission of kindness',
        'legal-title':'We Operate Legally and Transparently',
        'contact-title':'Contact Us',
        'partners-label':'Trusted & Supported by',
      },
    };
    Object.entries(t[lang]||{}).forEach(([k,v]) => {
      const el = document.querySelector<HTMLElement>(`[data-i18n-about="${k}"]`);
      if (el) el.textContent = v;
    });
  };

  const saved = localStorage.getItem('lang') || 'id';
  applyLang(saved);
  document.addEventListener('langchange', (e) => applyLang((e as CustomEvent).detail));
</script>
